<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: the panel with scripted data, for checking every state
             without WhatsApp, a key or any cost. Exported so it can be opened with
             `adb shell am start -n com.jev.overseas/com.jev.overseas.assistant.preview.PanelPreviewActivity`. -->
        <activity
            android:name="com.jev.overseas.assistant.preview.PanelPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Jev" />
        <!-- The setup screen with a placeholder key, for screenshots without the real key. -->
        <activity
            android:name="com.jev.overseas.assistant.preview.SetupPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Jev" />
    </application>
</manifest>
